# Copy to .env and fill in. Never commit .env.
PORT_API=3007
PORT_BATCH=3008

# MongoDB: MONGO_PROD is used when NODE_ENV=production, MONGO_DEV otherwise
MONGO_DEV=
MONGO_PROD=

# Secret that signs the login tokens (JWT)
SECRET_TOKEN=

# PostgreSQL (bookings and payments): same rule as MongoDB
POSTGRES_DEV=
POSTGRES_PROD=

# Redis (chat history, rate limits, counters)
REDIS_URL=redis://localhost:6379

# kostay-ai-search; leave AI_SEARCH_URL empty to use keyword search only
AI_SEARCH_URL=
AI_SEARCH_API_KEY=
